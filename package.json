{
  "name": "@helpscout/bitmotion",
  "version": "1.0.0",
  "description": "Live Bitmaker-style dithered motion graphics for the web. Canvas 2D only — no dependencies, no assets, no network.",
  "keywords": [
    "canvas",
    "dither",
    "atkinson",
    "animation",
    "generative",
    "background",
    "helpscout"
  ],
  "license": "UNLICENSED",
  "author": "Help Scout",
  "homepage": "https://github.com/helpscout/bitmotion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helpscout/bitmotion.git"
  },
  "bugs": {
    "url": "https://github.com/helpscout/bitmotion/issues"
  },
  "main": "bitmotion.js",
  "types": "bitmotion.d.ts",
  "unpkg": "bitmotion.js",
  "jsdelivr": "bitmotion.js",
  "exports": {
    ".": {
      "types": "./bitmotion.d.ts",
      "default": "./bitmotion.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.mjs",
      "require": "./react.cjs",
      "default": "./react.cjs"
    },
    "./export": {
      "types": "./bitmotion-export.d.ts",
      "default": "./bitmotion-export.js"
    },
    "./bitmotion.js": "./bitmotion.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bitmotion.js",
    "bitmotion.d.ts",
    "bitmotion-export.js",
    "bitmotion-export.d.ts",
    "react.cjs",
    "react.mjs",
    "react.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/react.mjs && node test/worker.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
